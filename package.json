{
  "name": "bikelivery-server",
  "version": "2.6.1",
  "description": "Bikelivery",
  "main": "main.ts",
  "scripts": {
    "start": "node dist/main",
    "docker": "cross-env DIR=bikelivery-server docker-compose -f docker-compose.dev.yml -p bikelivery-server up --force-recreate",
    "dev": "cross-env ENV=development nest start --watch",
    "debug": "nest start --debug --watch",
    "test": "cross-env ENV=testing jest --testPathIgnorePatterns test/e2e test/integration --watchAll",
    "test:ci": "cross-env ENV=testing jest --testPathIgnorePatterns test/e2e test/integration",
    "test:integration": "docker-compose -f docker-compose.test.integration.yml up -d && pnpm run test:integration:ci && docker-compose -f docker-compose.test.integration.yml down -v",
    "test:integration:ci": "cross-env ENV=testing jest --testPathPattern='test/integration/.*\\.test\\.ts'",
    "test:e2e": "docker-compose -f docker-compose.test.integration.yml up -d && pnpm run test:e2e:ci && docker-compose -f docker-compose.test.integration.yml down -v",
    "test:e2e:ci": "cross-env ENV=testing jest --testPathPattern='test/e2e/.*\\.test\\.ts'",
    "build": "nest build",
    "typeorm": "pnpm run build && typeorm-ts-node-commonjs",
    "migration:generate": "pnpm run typeorm -- migration:generate -d dist/db/typeorm.config.js",
    "migration:run": "pnpm run typeorm -- migration:run -d dist/db/typeorm.config.js",
    "migration:revert": "pnpm run typeorm -- migration:revert -d dist/db/typeorm.config.js",
    "lint": "eslint .",
    "format": "prettier --ignore-path ../.gitignore --write \"**/*.+(js|ts)\"",
    "update:all": "corepack up && pnpm update"
  },
  "author": "Jakub Cieślik",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@nestjs-modules/ioredis": "^2.2.1",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "bcryptjs": "^3.0.3",
    "cache-manager": "^7.2.8",
    "cache-manager-ioredis-yet": "^2.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-session": "^2.1.1",
    "core-js": "^3.49.0",
    "dotenv": "^17.4.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.5",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.19",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.33",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "jest": "^30.3.0",
    "prettier": "^3.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
